---
const { title, companyName, companyDescription, companyLink, fromDate, toDate } = Astro.props;
---

<div class="mb-5 pb-4 border-b border-gray-200 last:border-0 last:pb-0 last:mb-0">
  <div class="flex flex-wrap justify-between items-baseline gap-x-3">
    <h3 class="font-bold">{title}</h3>
    <span class="text-sm font-bold whitespace-nowrap">{fromDate} – {toDate}</span>
  </div>
  <div class="font-bold text-sm mb-1">
    {companyLink ? (
      <a href={companyLink} target="_blank" class="text-blue-700 hover:underline">{companyName}</a>
    ) : (
      <span>{companyName}</span>
    )}{companyDescription}
  </div>
  <div class="text-sm">
    <slot />
  </div>
</div>
