---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const last_posts = posts.slice(0, 3);
---

<BaseLayout>

    <div class="pb-12 mt-5">
      <div class="text-xl py-1">Hey there 👋</div>
      <div class="text-5xl font-bold">From Engineer Bot</div>
      <div class="text-3xl py-3 font-bold">Staff Consultant Engineer</div>
      <div class="py-2">
        <text class="text-justify">
          Zaheer Ud Din is the engineer teams bring in when a system that "works fine" starts cracking under real use, or when a monolith everyone's afraid to touch needs to become something the business can actually grow on. With 8+ years in the industry, he's currently federating product-catalog and identity events across STC's OSS/BSS systems at DNext, and before that turned a manual billing process at BILL.com into a fully automated, zero-loss delivery system.
        <br>
        <br>He previously led the GRID 2.0 platform revamp at Global Rescue — work Fast Company recognized on its Most Innovative Companies list in 2024 — leading a team of 6 engineers through the shift from an aging monolith to microservices built on Java, Spring Boot, Kafka, and AWS.
        <br>
        <br>He leads small teams, ships production systems that other teams end up depending on, and makes sure the engineers around him are shipping better too. As you navigate his portfolio, you'll find that same thread through the projects he's undertaken and the roles he's held.          </text
        >
      </div>
      <div class="mt-8">
        <a class="btn" href="https://twitter.com/zhr_ddn" target="_blank"> Let's connect!</a>
      </div>
    </div>

    <div>
      <div class="text-3xl w-full font-bold mb-2">My last projects {"</>"}</div>
    </div>

    <!-- <HorizontalCard
      title="Demo Project 1"
      img="/post_img.webp"
      desc="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
      url="#"
      badge="NEW"
    /> -->
    <!-- <div class="divider my-0"></div>
    <HorizontalCard
    title="Demo Project 2"
    img="/post_img.webp"
    desc="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
    url="#"
  /> -->
    <!-- <div class="divider my-0"></div>
    <HorizontalCard
    title="Demo Project 3"
    img="/post_img.webp"
    desc="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
    url="#"
    badge="FOSS"
  /> -->


    <div>
      <div class="text-3xl w-full font-bold mb-5 mt-10">Latest from blog</div>
    </div>

    {
      last_posts.map((post) => (
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          target="_self"
          badge={post.data.badge}
          url={post.data.url}
        />
        <div class="divider my-2"></div>
      ))
    }

</BaseLayout>
