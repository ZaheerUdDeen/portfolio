---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const last_posts = posts.slice(0, 3);
---

<BaseLayout>

    <div class="pb-12 mt-5">
      <div class="text-xl py-1">Hey there 👋</div>
      <div class="text-5xl font-bold">From Engineer Bot</div>
      <div class="text-3xl py-3 font-bold">Staff Consultant Engineer · AI-Native Builder</div>
      <div class="py-2">
        <text class="text-justify">
          Zaheer Ud Din is an AI-native staff engineer. He builds production systems with Claude Code and Cursor, and builds AI into the products themselves: agentic LLM workflows with tool calling (MCP), guardrails, evals, and human-in-the-loop review. With 8+ years in the industry, he's currently at DNext, where he built an agent that converts arbitrary Excel product catalogues into STC's template format, alongside the Kafka and Camunda engine that federates catalog and identity events across STC's OSS/BSS systems.
        <br>
        <br>Before that he turned a manual billing process at BILL.com into a zero-loss automated pipeline, and led the GRID 2.0 platform revamp at Global Rescue — work Fast Company recognized on its Most Innovative Companies list in 2024 — guiding a team of 6 engineers from an aging monolith to microservices on Java, Spring Boot, Kafka, and AWS.
        <br>
        <br>Outside work he runs PerFinAI, an AI-native finance assistant built and maintained largely by agents inside a Claude Code harness he designed: custom skills, subagents, hooks, and golden-dataset evals. He leads small teams, ships systems other teams depend on, and makes the engineers around him faster.          </text
        >
      </div>
      <div class="mt-8">
        <a class="btn" href="https://twitter.com/zhr_ddn" target="_blank"> Let's connect!</a>
      </div>
    </div>

    <div>
      <div class="text-3xl w-full font-bold mb-2">My last projects {"</>"}</div>
    </div>

